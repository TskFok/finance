# 复制为 .env 后填写。不要提交 .env。
# 下列 FINANCE_* 与 config.yaml 一一对应，docker compose 会传入应用容器。

# MySQL 容器 root 密码。仅用于初始化数据库，config.yaml 中没有这一项。
MYSQL_ROOT_PASSWORD=

# 日志。对应 log.level：debug、info、warn、error
FINANCE_LOG_LEVEL=info

# 服务器。对应 server.port、server.mode、server.base_url
# APP_PORT 是宿主机映射端口，容器内仍监听 FINANCE_SERVER_PORT
FINANCE_SERVER_PORT=:8811
FINANCE_SERVER_MODE=release
FINANCE_SERVER_BASE_URL=http://localhost:8811
APP_PORT=8811

# 数据库。对应 database.*
# 容器内请使用服务名 mysql，不要写成 config.yaml 里的 127.0.0.1
FINANCE_DATABASE_HOST=mysql
FINANCE_DATABASE_PORT=3306
FINANCE_DATABASE_USERNAME=finance
FINANCE_DATABASE_PASSWORD=
FINANCE_DATABASE_DBNAME=finance
FINANCE_DATABASE_CHARSET=utf8mb4

# JWT。对应 jwt.secret、jwt.expire_hours
FINANCE_JWT_SECRET=
FINANCE_JWT_EXPIRE_HOURS=24

# 邮件。对应 email.*
FINANCE_EMAIL_ENABLED=false
FINANCE_EMAIL_HOST=smtp.qq.com
FINANCE_EMAIL_PORT=465
FINANCE_EMAIL_USERNAME=
FINANCE_EMAIL_PASSWORD=
FINANCE_EMAIL_FROM=记账系统

# 飞书扫码登录。对应 feishu.*
FINANCE_FEISHU_ENABLED=false
FINANCE_FEISHU_APP_ID=
FINANCE_FEISHU_APP_SECRET=
FINANCE_FEISHU_AUTO_CREATE_USER=false

# 可选：覆盖 compose 使用的镜像
# make docker-build-linux-amd64 生成 finance:latest-linux-amd64
# make docker-build-linux-arm64 生成 finance:latest-linux-arm64
# FINANCE_IMAGE=finance:latest-linux-amd64
